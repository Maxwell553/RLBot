IBKR_HOST=127.0.0.1
# Required for paper-submit / live-submit. Live TWS is 7496; paper TWS is 7497.
IBKR_PORT=7497
IBKR_CLIENT_ID=17
# Required for paper-submit / live-submit
IBKR_ACCOUNT=
LIVE_TRADER_MODE=dry_run
# Required to place a live (port 7496/4001) order, together with config allow_live
# and `python LiveTrader/trader.py live-submit --arm-live`
LIVE_TRADER_CONFIRM=
# Set to 1 only if the weekday 15:45 launchd job should arm live-submit
# LIVE_TRADER_LAUNCHD_LIVE=1
# LIVE_TRADER_AUM=1000
