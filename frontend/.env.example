# Local read-only Research Operations adapter (scripts/frontend_api.py).
VITE_API_URL=http://127.0.0.1:8787

# Only needed if the API was started with MARKETTRAINER_API_TOKEN set.
# VITE_API_TOKEN=

# Separate transactional mandate workflow service (scripts/workflow_api.py).
# Use only the investor token in a public investor build. The operator token
# belongs only in an internal Research Operations build.
VITE_WORKFLOW_API_URL=http://127.0.0.1:8790
# Local-dev defaults match scripts/workflow_api.py when MARKETTRAINER_WORKFLOW_TOKENS is unset.
VITE_INVESTOR_WORKFLOW_TOKEN=investor-local
VITE_OPS_WORKFLOW_TOKEN=operator-local

# Operations routes and the mode switch are automatic in Vite development.
# Production deployments must opt in explicitly; API authorization is still
# required and these flags are not security boundaries.
# VITE_ENABLE_OPS=true
# VITE_SHOW_MODE_SWITCH=true
