# Page data source for ops GETs (dashboard / runs / results / forward):
#   static  — Vite public/data/*.json (default; milliseconds; preferred)
#   api     — live research API on :8787 (can stall on iCloud Desktop)
#   offline — labeled synthetic sandbox (no Runs/)
VITE_DATA_SOURCE=static

# Only used when VITE_DATA_SOURCE=api.
# Empty string = fetch('/api/...') through Vite — no browser CORS.
# Set to http://127.0.0.1:8787 only if you must hit the API directly (CORS required).
VITE_API_URL=

# Workflow API (scripts/workflow_api.py) — separate service / CORS allowlist.
VITE_WORKFLOW_API_URL=http://127.0.0.1:8790
# Example local actor tokens; must match MARKETTRAINER_WORKFLOW_TOKENS on the server.
VITE_INVESTOR_WORKFLOW_TOKEN=investor-local
VITE_OPS_WORKFLOW_TOKEN=operator-local

# Only needed if the API was started with MARKETTRAINER_API_TOKEN set.
# VITE_API_TOKEN=

# Ops console is available at /ops in local/dev builds by default.
# Set true to force-enable the ops surface in production builds.
# VITE_ENABLE_OPS=true
# Show the Investor / Ops mode switch even when ops is force-enabled.
# VITE_SHOW_MODE_SWITCH=true
